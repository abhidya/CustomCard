# ── Per-environment guide ────────────────────────────────────────────────────
# dev   → copy to infra/env/.env and use docker-compose.dev.yml
# qa    → set in Vercel dashboard (Preview environment); use Neon branch DB URL
# prod  → set in Vercel dashboard (Production environment); use Neon prod DB URL
#          CUSTOMCARD_ENV=production
#          Live order gates are owned by admin safety controls.
#          CUSTOMCARD_API_RUNTIME=postgres   (production must fail closed without durable auth/idempotency)
# ─────────────────────────────────────────────────────────────────────────────
CUSTOMCARD_ENV=dev
POSTGRES_PASSWORD=replace-me-do-not-commit-real-secret
DATABASE_URL=postgres://customcard:customcard@postgres:5432/customcard_dev
QUEUE_URL=redis://redis:6379/0
# Droplet TLS reverse proxy (prod compose uses these).
CADDY_DOMAIN=customcard.example.com
CADDY_ACME_EMAIL=ops@example.com
OBJECT_STORE_URL=http://minio:9000
# Prod droplet compose builds OBJECT_STORE_URL from this HTTPS host.
OBJECT_STORE_HOST=<cloudflare-account-id>.r2.cloudflarestorage.com
OBJECT_STORE_BUCKET=customcard-dev
OBJECT_STORE_ACCESS_KEY_ID=replace-me
OBJECT_STORE_SECRET_ACCESS_KEY=replace-me
OBJECT_STORE_READ_ACCESS_KEY_ID=replace-me-optional
OBJECT_STORE_READ_SECRET_ACCESS_KEY=replace-me-optional
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_SIGNING_SECRET=replace-me-do-not-commit-real-secret
OBJECT_STORE_PUBLIC_BASE_URL=http://127.0.0.1:4173/api/artifacts
ARTIFACT_SIGNED_URL_TTL_MINUTES=15
# Cloudflare R2 production example:
# Create the R2 bucket first; object-scoped R2 tokens cannot create buckets.
# OBJECT_STORE_HOST=<cloudflare-account-id>.r2.cloudflarestorage.com
# OBJECT_STORE_URL=https://<cloudflare-account-id>.r2.cloudflarestorage.com
# OBJECT_STORE_BUCKET=customcard-prod
# OBJECT_STORE_REGION=auto
# OBJECT_STORE_PUBLIC_BASE_URL=https://customcard-three.vercel.app/api/artifacts
SECRET_PROVIDER=local_env
CUSTOMCARD_API_RUNTIME=contract
CUSTOMCARD_POSTGRES_POOL_MAX=5
CUSTOMCARD_POSTGRES_POOL_CONNECTION_TIMEOUT_MS=5000
CUSTOMCARD_POSTGRES_POOL_IDLE_TIMEOUT_MS=10000
AUTH_SESSION_SECRET=replace-me-do-not-commit-real-secret
CUSTOMCARD_CUSTOMER_SESSION_TOKEN=replace-me-do-not-commit-real-secret
CUSTOMCARD_ADMIN_SESSION_TOKEN=replace-me-do-not-commit-real-secret
CUSTOMCARD_AUTH_CALLBACK_URL=https://customcard-three.vercel.app/oauth/callback
IDEMPOTENCY_KEY_TTL_HOURS=24
AUTH0_DOMAIN=replace-me
AUTH0_CLIENT_ID=replace-me
AUTH0_CLIENT_SECRET=replace-me
AUTH0_AUDIENCE=replace-me
CLERK_SECRET_KEY=replace-me
CLERK_JWT_KEY=replace-me
CLERK_AUTHORIZED_PARTIES=replace-me
CLERK_ISSUER=replace-me
CLERK_AUDIENCE=customcard-api
CUSTOMCARD_GOOGLE_CALENDAR_TOKEN_SOURCE=
CLERK_OAUTH_ACCESS_TOKEN_ENDPOINT=https://api.clerk.com/v1/users/{user_id}/oauth_access_tokens/{provider}
SUPABASE_URL=replace-me
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
FIREBASE_API_KEY=replace-me
FIREBASE_PROJECT_ID=replace-me
FIREBASE_SERVICE_ACCOUNT_JSON=replace-me
COGNITO_DOMAIN=replace-me
COGNITO_USER_POOL_ID=replace-me
COGNITO_APP_CLIENT_ID=replace-me
CARDDAV_BASE_URL=replace-me
CARDDAV_USERNAME=replace-me
CARDDAV_APP_PASSWORD=replace-me
CARDDAV_ADDRESSBOOK_PATH=replace-me
# Google Calendar/Gmail OAuth. The client ID is public-ish; the secret must
# stay in local/Vercel secret storage and must not be committed.
GOOGLE_OAUTH_CLIENT_ID=604984591268-dujee5ri2ff87sqe3iv3m58nj2e2mibc.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace-me-do-not-commit-real-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/oauth/callback
GOOGLE_OAUTH_TOKEN_ENCRYPTION_KEY=replace-me-random-32-byte-secret
GOOGLE_OAUTH_STATE_SECRET=replace-me-random-state-signing-secret
GOOGLE_CALENDAR_IMPORT_MAX_RESULTS=10
# ── Event platform integrations ───────────────────────────────────────────────
# Eventbrite — OAuth 2.0 · https://www.eventbrite.com/platform/api
# Register app at: https://www.eventbrite.com/account-settings/apps
# Scopes: event:read  · Rate limit: 1,000 req/hour per token
EVENTBRITE_CLIENT_ID=replace-me
EVENTBRITE_CLIENT_SECRET=replace-me
# Luma — API key per calendar · https://docs.luma.com/reference/getting-started-with-your-api
# Obtain from: Luma Settings → Developer → API Keys (requires Luma Plus subscription)
# Rate limit: 200 req/min per calendar
LUMA_API_KEY=replace-me
# Meetup — OAuth 2.0 GraphQL · https://www.meetup.com/graphql/guide/
# Register at: https://secure.meetup.com/meetup_api/oauth_consumers/ (requires Meetup Pro)
# Endpoint: https://api.meetup.com/gql  · Rate limit: 500 points/60s
MEETUP_CLIENT_ID=replace-me
MEETUP_CLIENT_SECRET=replace-me
# Partiful — no official API as of 2026; placeholder for when they launch a dev program
# PARTIFUL_API_KEY=
