{
  "name": "customcard",
  "version": "0.1.0",
  "description": "Relationship-aware greeting-card CRM and print-production MVP.",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhidya/CustomCard.git"
  },
  "bugs": {
    "url": "https://github.com/abhidya/CustomCard/issues"
  },
  "homepage": "https://github.com/abhidya/CustomCard#readme",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "mobile:web:preview": "vite --host 127.0.0.1 --open /?view=mobile",
    "build": "tsc -b && vite build",
    "check": "npm run test -- --run && npm run test:coverage && npm run build && npm audit --audit-level=high",
    "test": "vitest run --no-file-parallelism",
    "test:coverage": "vitest run --coverage src/*.test.ts tests/infra-contract.test.ts tests/mobile-contract.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "api:serve": "node scripts/api-server.mjs",
    "api:doctor": "node scripts/api-server.mjs --doctor",
    "api:doctor:memory": "CUSTOMCARD_API_RUNTIME=memory AUTH_SESSION_SECRET=test-auth-session-secret-32-chars CUSTOMCARD_CUSTOMER_SESSION_TOKEN=test-customer-session-token CUSTOMCARD_ADMIN_SESSION_TOKEN=test-admin-session-token node scripts/api-server.mjs --doctor",
    "api:doctor:postgres": "node scripts/postgres-runtime-doctor.mjs",
    "api:doctor:postgres:live": "CUSTOMCARD_POSTGRES_INTEGRATION_DOCTOR=enabled node scripts/postgres-integration-doctor.mjs",
    "api:doctor:postgres:http": "CUSTOMCARD_POSTGRES_API_HTTP_DOCTOR=enabled node scripts/postgres-api-http-doctor.mjs",
    "account:doctor:live": "CUSTOMCARD_ACCOUNT_AUTH_DOCTOR=enabled node scripts/account-auth-doctor.mjs",
    "card:benchmark": "node scripts/card-generation-benchmark.mjs",
    "card:copy-benchmark": "node scripts/card-copy-benchmark.mjs",
    "artifact:doctor": "node scripts/artifact-store-doctor.mjs",
    "artifact:doctor:s3:live": "CUSTOMCARD_S3_ARTIFACT_DOCTOR=enabled node scripts/artifact-store-s3-live-doctor.mjs",
    "r2:bucket:list": "wrangler r2 bucket list",
    "r2:bucket:create": "wrangler r2 bucket create",
    "r2:bucket:create:prod": "wrangler r2 bucket create customcard-prod",
    "cloud:doctor": "node scripts/cloud-artifact-iac-doctor.mjs",
    "cloud:artifact:proof:doctor": "node scripts/cloud-artifact-proof-readiness-doctor.mjs",
    "persistence:doctor": "node scripts/persistence-doctor.mjs",
    "deployment:doctor": "node scripts/deployment-readiness.mjs",
    "demo:doctor": "node scripts/demo-reset.mjs",
    "localization:doctor": "node scripts/localization-doctor.mjs",
    "security:doctor": "node scripts/security-privacy-accessibility-doctor.mjs",
    "customer:accessibility:doctor": "node scripts/customer-accessibility-evidence-doctor.mjs",
    "accessibility:doctor": "node scripts/accessibility-readiness-doctor.mjs",
    "external:audit:doctor": "node scripts/external-audit-readiness-doctor.mjs",
    "e2e:coverage:doctor": "node scripts/e2e-coverage-doctor.mjs",
    "ai:doctor": "node scripts/ai-provider-readiness-doctor.mjs",
    "ai:queue:doctor": "node scripts/ai-queue-operations-doctor.mjs",
    "observability:doctor": "node scripts/observability-readiness-doctor.mjs",
    "metrics:doctor": "node scripts/metrics-platform-doctor.mjs",
    "retail:doctor": "node scripts/retail-fulfillment-readiness-doctor.mjs",
    "payment:doctor": "node scripts/payment-readiness-doctor.mjs",
    "mobile:render:doctor": "node scripts/mobile-render-readiness-doctor.mjs",
    "hosted:api:doctor": "node scripts/hosted-api-readiness-doctor.mjs",
    "reviewer:db:seed:doctor": "node scripts/reviewer-db-seed-readiness-doctor.mjs",
    "business:engagement:doctor": "node scripts/business-engagement-readiness-doctor.mjs",
    "admin:operations:doctor": "node scripts/admin-operations-doctor.mjs",
    "printer:pricing:doctor": "node scripts/printer-pricing-doctor.mjs",
    "printer:coupons:collect": "node scripts/printer-coupon-collector.mjs",
    "retail:entrypoints:collect": "node scripts/retail-printer-entrypoint-collector.mjs",
    "provider:governance:doctor": "node scripts/provider-governance-doctor.mjs",
    "provider:operations:doctor": "node scripts/provider-operations-doctor.mjs",
    "capacity:doctor": "node scripts/capacity-plan-doctor.mjs",
    "serve:dist": "node scripts/serve-dist.mjs",
    "migrate": "node scripts/migrate.mjs",
    "runtime:doctor": "node scripts/validate-runtime-env.mjs",
    "worker": "node scripts/worker.mjs",
    "mobile:release:doctor": "npm --prefix apps/mobile run release:doctor"
  },
  "dependencies": {
    "@clerk/react": "^6.9.0",
    "lucide-react": "^1.17.0",
    "pg": "^8.16.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "overrides": {
    "wrangler": {
      "esbuild": "0.28.1"
    }
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.15",
    "vitest": "^4.1.7",
    "wrangler": "^4.99.0"
  }
}
