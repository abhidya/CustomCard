    "artifact:inventory": "node scripts/artifact-inventory.mjs",
    "r2:bucket:list": "wrangler r2 bucket list",
    "r2:bucket:create": "wrangler r2 bucket create",
    "r2:bucket:create:prod": "wrangler r2 bucket create customcard-prod",
    "cloud:doctor": "node scripts/cloud-artifact-iac-doctor.mjs",
    "cloud:artifact:proof:doctor": "node scripts/cloud-artifact-proof-readiness-doctor.mjs",
    "persistence:doctor": "node scripts/persistence-doctor.mjs",
    "deployment:doctor": "node scripts/deployment-readiness.mjs",
