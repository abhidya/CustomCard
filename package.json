{
  "name": "customcard",
  "version": "0.1.0",
  "description": "Relationship-aware greeting-card CRM and print-production MVP.",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhidya/CustomCard.git"
  },
  "bugs": {
    "url": "https://github.com/abhidya/CustomCard/issues"
  },
  "homepage": "https://github.com/abhidya/CustomCard#readme",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "mobile:web:preview": "vite --host 127.0.0.1 --open /?view=mobile",
    "build": "tsc -b && vite build && node scripts/prune-vercel-api-shims.mjs",
    "check": "npm run test -- --run && npm run test:coverage && npm run build && npm audit --audit-level=high",
    "test": "vitest run --no-file-parallelism",
    "test:coverage": "vitest run --no-file-parallelism --coverage",
    "preview": "vite preview --host 127.0.0.1",
    "api:serve": "node scripts/api-server.mjs",
    "api:doctor": "node scripts/api-server.mjs --doctor",
    "api:doctor:memory": "CUSTOMCARD_API_RUNTIME=memory AUTH_SESSION_SECRET=test-auth-session-secret-32-chars CUSTOMCARD_CUSTOMER_SESSION_TOKEN=test-customer-session-token CUSTOMCARD_ADMIN_SESSION_TOKEN=test-admin-session-token node scripts/api-server.mjs --doctor --local-auth-fallbacks",
    "api:doctor:postgres": "node scripts/postgres-runtime-doctor.mjs",
    "api:doctor:postgres:live": "node scripts/postgres-integration-doctor.mjs --confirm-live-postgres-integration-doctor",
    "api:doctor:postgres:http": "node scripts/postgres-api-http-doctor.mjs --confirm-live-postgres-api-http-doctor",
    "account:doctor:live": "node scripts/account-auth-doctor.mjs --confirm-live-account-auth-doctor",
    "card:benchmark": "node scripts/card-generation-benchmark.mjs",
    "card:copy-benchmark": "node scripts/card-copy-benchmark.mjs",
