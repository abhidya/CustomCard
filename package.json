    "retail:entrypoints:collect": "node scripts/retail-printer-entrypoint-collector.mjs",
    "provider:governance:doctor": "node scripts/provider-governance-doctor.mjs",
    "provider:operations:doctor": "node scripts/provider-operations-doctor.mjs",
    "capacity:doctor": "node scripts/capacity-plan-doctor.mjs",
    "serve:dist": "node scripts/serve-dist.mjs",
    "migrate": "node scripts/migrate.mjs",
    "runtime:doctor": "node scripts/validate-runtime-env.mjs",
    "provider:setup": "node scripts/provider-control.mjs setup",
    "provider:status": "node scripts/provider-control.mjs status",
    "provider:dashboard": "node scripts/provider-dashboard.mjs",
    "provider:dashboard:open": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/open-provider-queue-dashboard.ps1",
    "provider:dashboard:shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/install-provider-queue-dashboard-shortcuts.ps1",
    "provider:doctor": "node scripts/provider-control.mjs doctor",
    "provider:start": "node scripts/provider-control.mjs start",
    "provider:once": "node scripts/provider-control.mjs once",
    "worker": "node scripts/worker.mjs",
    "worker:comfy": "node scripts/local-comfy-worker.mjs",
    "worker:provider:http": "node scripts/provider-http-worker.mjs",
    "comfy:models:setup": "node scripts/setup-comfyui-models.mjs",
    "comfy:multigpu:workflows": "node scripts/comfyui-multigpu-workflows.mjs --write --check",
    "comfy:multigpu:preflight": "node scripts/comfyui-multigpu-workflows.mjs --check --require-live",
    "comfy:multigpu:smoke": "node scripts/comfyui-multigpu-smoke.mjs",
