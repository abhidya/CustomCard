# CustomCard mobile app — environment variables
#
# Copy to `.env` for QA/prod preview builds. Values here are NON-SECRET client
# configuration only. Secrets (Clerk secret key, provider credentials, database
# URLs) belong to the API deployment, never to the mobile app.

# Required. Logical environment label: qa | production.
CUSTOMCARD_APP_ENV=qa

# Required. HTTPS API URL for the selected environment. Set both in EAS so the
# build profile can select safely from CUSTOMCARD_APP_ENV.
CUSTOMCARD_QA_API_BASE_URL=https://api.qa.customcard.test
CUSTOMCARD_PRODUCTION_API_BASE_URL=https://api.customcard.test

# Optional override. If set alongside the selected env-specific URL, it must
# match after trailing slash normalization.
# CUSTOMCARD_API_BASE_URL=https://api.qa.customcard.test

# Required. Clerk *publishable* key (public, pk_test_ for QA, pk_live_ for prod).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Required. Must be allowlisted in Clerk Redirect URLs for Google/Apple OAuth.
CUSTOMCARD_OAUTH_REDIRECT_URL=customcard://sso-callback

# Safety gate mirrored from the backend. Keep disabled.

# Optional. EAS project id (set automatically by `eas init`; can also be
# provided via EAS environment variables for CI builds).
# EAS_PROJECT_ID=
