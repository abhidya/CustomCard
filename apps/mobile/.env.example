# CustomCard mobile app — environment variables
#
# Copy to `.env` for local development. Values here are NON-SECRET client
# configuration only. Secrets (Clerk secret key, provider credentials, database
# URLs) belong to the API deployment, never to the mobile app.

# Required. Base URL of the CustomCard API the app talks to.
#   Local dev (memory runtime):  http://127.0.0.1:8787
#   Local dev (Vite middleware): http://127.0.0.1:5173
#   Hosted (example):            https://customcard-three.vercel.app
# Production builds must use https://; the app refuses http:// outside dev.
CUSTOMCARD_API_BASE_URL=http://127.0.0.1:8787

# Required for real sign-in. Clerk *publishable* key (public, pk_test_/pk_live_).
# Without it, release builds show a configuration error; dev builds offer the
# local session-token mode for the memory-runtime API.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Optional. Logical environment label: development | staging | production.
CUSTOMCARD_APP_ENV=development

# Safety gate mirrored from the backend. Keep disabled.
REAL_ORDER_KILL_SWITCH=disabled

# Optional. EAS project id (set automatically by `eas init`; can also be
# provided via EAS environment variables for CI builds).
# EAS_PROJECT_ID=
