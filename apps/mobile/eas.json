{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "qa",
      "env": {
        "CUSTOMCARD_APP_ENV": "qa",
        "CUSTOMCARD_OAUTH_REDIRECT_URL": "customcard://sso-callback"
      }
    },
    "qa": {
      "distribution": "internal",
      "channel": "qa",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "CUSTOMCARD_APP_ENV": "qa",
        "CUSTOMCARD_OAUTH_REDIRECT_URL": "customcard://sso-callback"
      }
    },
    "preview": {
      "extends": "qa",
      "channel": "qa"
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "CUSTOMCARD_APP_ENV": "production",
        "CUSTOMCARD_OAUTH_REDIRECT_URL": "customcard://sso-callback"
      }
    },
    "apk": {
      "extends": "production",
      "distribution": "internal",
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "CUSTOMCARD_OAUTH_REDIRECT_URL": "customcard://sso-callback"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {},
      "android": {}
    }
  }
}
